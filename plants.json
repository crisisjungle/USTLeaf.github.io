    {
      "id": "0106",
      "cn_name": "朱蕉",
      "latin_name": "Cordyline fruticosa (L.) A. Chev.",
      "family": "龙舌兰科 Agavaceae",
      "type": "常绿灌木",
      "synonyms": [
        "红竹",
        "万年竹",
        "紫叶朱蕉"
      ],
      "native_hk": false,
      "description": "常绿灌木，高2-3米。茎直立，粗壮，有树皮状外观。叶片披针形或椭圆状披针形，长20-60厘米，宽5-10厘米，叶色多样，品种不同而异，常见有绿色、红色、紫色或杂色斑纹。叶簇生于茎顶，叶柄长5-10厘米。圆锥花序顶生，花小，白色或淡紫色。果实浆果状，红色。原产于热带亚洲和太平洋岛屿地区，在热带和亚热带地区广泛栽培作为观叶植物。在港科大校园中主要种植多种颜色的朱蕉品种，其中以红叶和紫叶品种较为常见，为校园增添丰富的色彩。",
      "iucn_status": "NE (未评估)",
